{
    // layout of the whole thing

    // goes from top to bottom
    "layout": [
        "upperBox",
        "getUser",
        "separator",
        "getOS",
        "cpuINFO",
        "memINFO",
        "lowerBox"
    ],

    // each colour is in HTML colour code with RGB values

    // ascii art config
    "ascii-config": {
        "red": 255,
        "green": 255,
        "blue": 255,
        "bold": 0 // 0 = No bold effect , 1 = Bold effect
    },

    // each modules individual customisation
    "upperBox-config": {
        "length": -1, // if -1 then that means it will automatically figure out length, else it will set to that value
        "red": 255,
        "green": 255,
        "blue": 255,
        "startChar": "┌",
        "endChar": "┐",
        "pipeChar": "="
    },

    "lowerBox-config": {
        "length": -1, // if -1 then that means it will automatically figure out length, else it will set to that value
        "red": 255,
        "green": 255,
        "blue": 255,
        "startChar": "└",
        "endChar": "┘",
        "pipeChar": "="
    },

    "separator-config": {
        "length": -1, // if -1 then that means it will automatically figure out length, else it will set to that value
        "red": 255,
        "green": 255,
        "blue": 255,
        "startChar": "|",
        "endChar": "|",
        "pipeChar": "-"
    },

    "getUser-config": {
        "red": 255,
        "green": 204,
        "blue": 255
    },

    "getOS-config": {
        "red": 255,
        "green": 204,
        "blue": 255
    },

    "cpuINFO-config": {
        "red": 255,
        "green": 204,
        "blue": 255
    },

    "memINFO-config": {
        "red": 255,
        "green": 204,
        "blue": 255
    }
}